# 실제 값은 .env(gitignore 대상)에 두거나 사내 시크릿 관리 솔루션을 통해 주입한다.
# 코드/CI 설정에 실제 접속정보를 하드코딩하지 말 것.
DATABASE_URL="mysql://user:password@localhost:3306/carehome_tms"
# 로컬 자체 발급 JWT 서명 시크릿. openssl rand -base64 32 등으로 생성해 .env에 설정
JWT_SECRET=

# localhost 외 추가 CORS 허용 origin(콤마 구분, 선택). LAN IP로 다른 기기에서 접속할 때만 설정.
CORS_ORIGINS=
