// 기준 문서: docs/plan/dev_plan_0709.md (§3.5, §4) + docs/ddl/carehome_tms_ddl_v1.2.sql
//
// 이 스키마는 위 DDL의 타입 레이어입니다. 아래 항목은 Prisma 스키마 언어로 표현할 수 없어
// prisma/migrations의 손으로 작성한 SQL이 유일한 근거입니다 — 이 모델들에 대해
// `prisma migrate dev`(자동 diff)를 실행하지 말 것. 항상 수동 마이그레이션으로 반영한다.
//   - ApprovalHistory: append-only 트리거 (UPDATE/DELETE 차단)
//   - LeaveBalance.remaining / SubstituteHolidayBalance.remaining: GENERATED ALWAYS AS ... STORED
//   - Facility.stagingRatio / approvalSteps, ApprovalLine.stepNo/delegationEnabled,
//     SubstituteHolidayLedger.carryableMinutes: CHECK 제약
//
// Prisma v7: 커넥션 URL은 여기 두지 않는다. CLI(migrate 등)는 ../prisma.config.ts,
// 런타임 PrismaClient는 src/prisma/prisma.service.ts의 @prisma/adapter-mariadb를 사용한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =============================================================
// [Phase 0] 공통 기반
// =============================================================

model Facility {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name              String   @db.VarChar(100)
  capacity          Int      @db.UnsignedSmallInt
  /// CHECK (staffing_ratio IN (2.1, 2.3)) — DB 레벨, 마이그레이션 SQL 참고
  staffingRatio     Decimal  @default(2.1) @map("staffing_ratio") @db.Decimal(3, 1)
  outsourcedMeal    Boolean  @default(false) @map("outsourced_meal")
  outsourcedLaundry Boolean  @default(false) @map("outsourced_laundry")
  /// [v1.2] CHECK (approval_steps BETWEEN 1 AND 3) — DB 레벨. 표준 3단계 = 사회복지사→사무국장→시설장 (D-13)
  approvalSteps     Int      @default(3) @map("approval_steps") @db.UnsignedTinyInt
  gpsLat            Decimal? @map("gps_lat") @db.Decimal(10, 7)
  gpsLng            Decimal? @map("gps_lng") @db.Decimal(10, 7)
  gpsRadiusM        Int?     @default(100) @map("gps_radius_m") @db.UnsignedSmallInt
  /// [v1.2] 출퇴근 태그 허용 시간 여유(교대 전후 n분, A-6 — Phase 3)
  tagMarginMinutes  Int?     @default(30) @map("tag_margin_minutes") @db.UnsignedSmallInt
  /// [v1.2] 태그 실패 시 관리자 호출 전화번호(C-11 — Phase 3). 실번호는 운영 설정에서 입력
  adminCallPhone    String?  @map("admin_call_phone") @db.VarChar(20)
  addonTargetScore  Decimal? @map("addon_target_score") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  teams               Team[]
  employees           Employee[]
  shiftTypes          ShiftType[]
  approvalLines       ApprovalLine[]
  approvalRequests    ApprovalRequest[]
  monthlyCensuses     MonthlyCensus[]
  dailyStaffingRules  DailyStaffingRule[]
  rosters             Roster[]
  shiftPatternPresets ShiftPatternPreset[]

  @@map("facility")
}

/// [v1.2 신설] 팀 (직원 등록 시 지정, 설정에서 변경 — §1.3, §4.5)
model Team {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId BigInt @map("facility_id") @db.UnsignedBigInt
  /// 예: 1층팀, 2층팀
  name       String @db.VarChar(50)
  sortOrder  Int    @default(0) @map("sort_order") @db.UnsignedSmallInt

  facility Facility @relation(fields: [facilityId], references: [id])

  employees          Employee[]
  dailyStaffingRules DailyStaffingRule[]

  @@unique([facilityId, name], map: "uq_team_name")
  @@map("team")
}

enum JobRole {
  DIRECTOR
  OFFICE_MANAGER
  SOCIAL_WORKER
  NURSE
  NURSE_AIDE
  PHYSICAL_THERAPIST
  OCCUPATIONAL_THERAPIST
  CAREGIVER
  CLERK
  DIETITIAN
  COOK
  HYGIENIST
  JANITOR
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

model Employee {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId    BigInt         @map("facility_id") @db.UnsignedBigInt
  /// [v1.2] 소속 팀(직원 등록 시 지정, 변경 가능). 종사자는 본인 팀 근무만 조회(개인정보 보호 — 앱 레벨)
  teamId        BigInt?        @map("team_id") @db.UnsignedBigInt
  name          String         @db.VarChar(50)
  /// 관리자 웹 로그인 ID(로컬 자체 JWT 단계). Cognito 전환 시 username 매핑 키로 재사용
  email         String?        @unique(map: "uq_employee_email") @db.VarChar(255)
  /// 비밀번호 해시(scrypt) — 평문 저장 금지. Cognito 전환 시 폐기 예정
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  jobRole       JobRole        @map("job_role")
  isRn          Boolean        @default(false) @map("is_rn")
  systemRole    SystemRole     @default(STAFF) @map("system_role")
  /// 연차연도(year_basis)·소멸 임박 판정(C-10)의 기준
  hireDate      DateTime       @map("hire_date") @db.Date
  status        EmployeeStatus @default(ACTIVE)
  canShiftWork  Boolean        @default(true) @map("can_shift_work")
  /// PIN 해시(bcrypt/argon2) — 평문 저장 금지
  pinHash       String?        @map("pin_hash") @db.VarChar(255)
  /// 저장된 서명 이미지의 오브젝트 스토리지 경로(key). 결재 권한자는 최초 승인 전 등록 필수(D-12, 앱 레벨 강제)
  signaturePath String?        @map("signature_path") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  team     Team?    @relation(fields: [teamId], references: [id])

  devices                         UserDevice[]
  approvalLinesAsApprover         ApprovalLine[]             @relation("ApprovalLineApprover")
  approvalLinesAsDeputy           ApprovalLine[]             @relation("ApprovalLineDeputy")
  approvalRequests                ApprovalRequest[]
  approvalRequestLinesAsApprover  ApprovalRequestLine[]      @relation("ApprovalRequestLineApprover")
  approvalRequestLinesAsDeputy    ApprovalRequestLine[]      @relation("ApprovalRequestLineDeputy")
  approvalHistories               ApprovalHistory[]
  leaveBalance                    LeaveBalance[]
  substituteHolidayBalance        SubstituteHolidayBalance[]
  substituteHolidayLedgers        SubstituteHolidayLedger[]  @relation("SubstituteHolidayLedgerEmployee")
  substituteHolidayLedgersCreated SubstituteHolidayLedger[]  @relation("SubstituteHolidayLedgerCreator")
  substituteHolidayLedgersAmended SubstituteHolidayLedger[]  @relation("SubstituteHolidayLedgerAmender")
  substituteHolidayLedgersRevoked SubstituteHolidayLedger[]  @relation("SubstituteHolidayLedgerRevoker")
  notifications                   Notification[]
  rostersSubmitted                Roster[]                   @relation("RosterSubmitter")
  rostersClosed                   Roster[]                   @relation("RosterCloser")
  scheduleEntries                 ScheduleEntry[]
  attendanceRecords               AttendanceRecord[]

  @@index([facilityId, jobRole, status], name: "idx_emp_facility_role")
  @@index([teamId], name: "idx_emp_team")
  @@map("employee")
}

model UserDevice {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employeeId   BigInt    @map("employee_id") @db.UnsignedBigInt
  deviceUid    String    @unique(map: "uq_device_uid") @map("device_uid") @db.VarChar(128)
  deviceLabel  String?   @map("device_label") @db.VarChar(100)
  registeredAt DateTime  @default(now()) @map("registered_at")
  /// 기기 분실 시 관리자 해제(원격 로그아웃)
  revokedAt    DateTime? @map("revoked_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], name: "idx_device_emp")
  @@map("user_device")
}

model ShiftType {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId        BigInt    @map("facility_id") @db.UnsignedBigInt
  code              String    @db.VarChar(10)
  label             String    @db.VarChar(30)
  startTime         DateTime? @map("start_time") @db.Time(0)
  endTime           DateTime? @map("end_time") @db.Time(0)
  breakMinutes      Int       @default(0) @map("break_minutes") @db.UnsignedSmallInt
  crossesMidnight   Boolean   @default(false) @map("crosses_midnight")
  countsAsWork      Boolean   @default(true) @map("counts_as_work")
  /// [v1.2] §4.1/§4.7 기준근무시간 인정분(분). 주간=480, 야간(주야비)=580(9h40m), 연차=480, 반차=240,
  /// 유급병가=480, 휴무·결근=0(불인정 — NULL 아닌 0). recognized_hours(DECIMAL)를 대체(정밀도 문제 해소).
  /// 유급휴일대체는 §4.4 규칙으로 ledger에서 별도 산정 — 본 칼럼 값은 근로자 관점 표기용
  recognizedMinutes Int?      @map("recognized_minutes") @db.UnsignedSmallInt
  /// [v1.2] 근무표 셀 표기(§4.7): 주/야/휴/연/오전/오후/유/병/결
  cellLabel         String?   @map("cell_label") @db.VarChar(10)
  sortOrder         Int       @default(0) @map("sort_order") @db.UnsignedSmallInt

  facility Facility @relation(fields: [facilityId], references: [id])

  approvalRequests ApprovalRequest[]
  scheduleEntries  ScheduleEntry[]
  patternItems     ShiftPatternItem[]

  @@unique([facilityId, code], map: "uq_shift_code")
  @@map("shift_type")
}

/// 법정공휴일 캘린더(대체공휴일 포함). §4.1 월 기준근무시간 산식의 입력, 유대 발생일 판정 보조
model PublicHoliday {
  holidayDate  DateTime @id @map("holiday_date") @db.Date
  name         String   @db.VarChar(50)
  isSubstitute Boolean  @default(false) @map("is_substitute")

  @@map("public_holiday")
}

// =============================================================
// [Phase 1] 결재 시스템 (개발 1순위)
// =============================================================

enum ApproverRole {
  SOCIAL_WORKER
  OFFICE_MANAGER
  DIRECTOR
}

model ApprovalLine {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId        BigInt        @map("facility_id") @db.UnsignedBigInt
  /// [v1.2] 1~3. 표준: 1=사회복지사, 2=사무국장, 3=시설장. CHECK (step_no BETWEEN 1 AND 3) — DB 레벨
  stepNo            Int           @map("step_no") @db.UnsignedTinyInt
  /// [v1.2] 역할 지정 방식. approverId 와 택일(둘 중 하나는 NOT NULL — 앱 레벨)
  approverRole      ApproverRole? @map("approver_role")
  /// 개인 지정 방식의 결재자
  approverId        BigInt?       @map("approver_id") @db.UnsignedBigInt
  /// 대결자(결재자 부재 시 자동 승계)
  deputyId          BigInt?       @map("deputy_id") @db.UnsignedBigInt
  /// [v1.2] 전결 위임(D-13). 대상은 stepNo=2(사무국장)에 한함 —
  /// ON이면 2단계 승인이 곧 최종 확정(APPROVED). CHECK (delegation_enabled = 0 OR step_no = 2) — DB 레벨
  delegationEnabled Boolean       @default(false) @map("delegation_enabled")
  effectiveFrom     DateTime      @default(now()) @map("effective_from") @db.Date
  effectiveTo       DateTime?     @map("effective_to") @db.Date

  facility Facility  @relation(fields: [facilityId], references: [id])
  approver Employee? @relation("ApprovalLineApprover", fields: [approverId], references: [id])
  deputy   Employee? @relation("ApprovalLineDeputy", fields: [deputyId], references: [id])

  @@unique([facilityId, stepNo, effectiveFrom], map: "uq_line_step")
  @@map("approval_line")
}

enum ApprovalRequestType {
  ANNUAL
  HALF_AM
  HALF_PM
  SUBSTITUTE_HOLIDAY
  SHIFT_CHANGE
  CANCEL
}

enum ApprovalRequestStatus {
  PENDING
  INTERIM_APPROVED
  APPROVED
  REJECTED
  CANCELED
  CANCELED_AFTER_APPROVAL
}

model ApprovalRequest {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId          BigInt                @map("facility_id") @db.UnsignedBigInt
  requesterId         BigInt                @map("requester_id") @db.UnsignedBigInt
  type                ApprovalRequestType
  /// SHIFT_CHANGE: 희망 근무유형
  desiredShiftId      BigInt?               @map("desired_shift_id") @db.UnsignedBigInt
  /// [v1.2] 사유. 연차·반차·유대=선택 / SHIFT_CHANGE=필수(D-14) — NOT NULL 강제는 앱 레벨
  reason              String?               @db.VarChar(500)
  /// CANCEL 유형이 참조하는 원건
  refRequestId        BigInt?               @map("ref_request_id") @db.UnsignedBigInt
  status              ApprovalRequestStatus @default(PENDING)
  /// [v1.2] 완료된 결재 단계 수(§3.4). PENDING=0, INTERIM_APPROVED에서 1 또는 2
  currentStep         Int                   @default(0) @map("current_step") @db.UnsignedTinyInt
  /// [v1.2] 전결로 최종 확정된 건(감사 식별 — D-13, 출력 서식에 "전결" 표기)
  isFinalByDelegation Boolean               @default(false) @map("is_final_by_delegation")
  /// 차감량. 연차=일수, 반차=0.5, 유대=1.0(1일 단위). 조정/취소는 NULL
  leaveDays           Decimal?              @map("leave_days") @db.Decimal(4, 1)
  /// 사후 신청 라벨(D-3)
  isRetroactive       Boolean               @default(false) @map("is_retroactive")
  /// 더블탭 중복 제출 방지
  idempotencyKey      String?               @unique(map: "uq_req_idem") @map("idempotency_key") @db.Char(36)
  createdAt           DateTime              @default(now()) @map("created_at")
  /// 종결(승인/반려/취소) 시각
  finalizedAt         DateTime?             @map("finalized_at")

  facility       Facility          @relation(fields: [facilityId], references: [id])
  requester      Employee          @relation(fields: [requesterId], references: [id])
  desiredShift   ShiftType?        @relation(fields: [desiredShiftId], references: [id])
  refRequest     ApprovalRequest?  @relation("ApprovalRequestCancelOf", fields: [refRequestId], references: [id])
  cancelRequests ApprovalRequest[] @relation("ApprovalRequestCancelOf")

  targetDates       ApprovalRequestDate[]
  requestLines      ApprovalRequestLine[]
  histories         ApprovalHistory[]
  notifications     Notification[]
  scheduleEntries   ScheduleEntry[]       @relation("ScheduleEntrySourceRequest")
  attendanceRecords AttendanceRecord[]    @relation("AttendanceRecordManualRequest")

  @@index([facilityId, status, createdAt], name: "idx_req_inbox")
  @@index([requesterId, createdAt], name: "idx_req_mine")
  @@map("approval_request")
}

/// 신청 대상 일자 (연차 다중일 지원. 반차·유대·조정은 1행). target_dates[]의 정규화
model ApprovalRequestDate {
  requestId  BigInt   @map("request_id") @db.UnsignedBigInt
  targetDate DateTime @map("target_date") @db.Date

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, targetDate])
  @@index([targetDate], name: "idx_reqdate_date")
  @@map("approval_request_date")
}

/// [v1.2 신설] 제출 시점 결재선 스냅샷 (엣지 12 — 설정 중도 변경 비소급).
/// 자기결재 회피(D-6)로 재배정된 결과를 반영해 저장
model ApprovalRequestLine {
  requestId         BigInt  @map("request_id") @db.UnsignedBigInt
  /// 1~3. CANCEL 유형은 1단계로 고정하고, 해당 시설 결재선에 등록된 결재자 전원을
  /// stepNo=1의 후보로 스냅샷한다(누구든 결재 가능 — leave.service.ts resolveCancellationRequestLines)
  stepNo            Int     @map("step_no") @db.UnsignedTinyInt
  /// 제출 시점에 확정된 해당 단계 결재자 후보(역할 지정이면 당시 재직자로 해석·고정).
  /// 같은 stepNo에 여러 행이 있으면 그 중 누구든 결재 시 해당 단계가 처리된다.
  approverId        BigInt  @map("approver_id") @db.UnsignedBigInt
  deputyId          BigInt? @map("deputy_id") @db.UnsignedBigInt
  /// 제출 시점 전결 설정(step 2)
  delegationEnabled Boolean @default(false) @map("delegation_enabled")

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver Employee        @relation("ApprovalRequestLineApprover", fields: [approverId], references: [id])
  deputy   Employee?       @relation("ApprovalRequestLineDeputy", fields: [deputyId], references: [id])

  @@id([requestId, stepNo, approverId])
  @@map("approval_request_line")
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  CANCEL
}

/// 결재 이력 — 불변(append-only). DB 트리거(trg_hist_no_update/trg_hist_no_delete)로 수정·삭제 차단.
/// 애플리케이션 계정에는 INSERT/SELECT만 부여할 것.
model ApprovalHistory {
  id                    BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  requestId             BigInt         @map("request_id") @db.UnsignedBigInt
  actorId               BigInt         @map("actor_id") @db.UnsignedBigInt
  action                ApprovalAction
  /// 결재 행위의 단계(제출/취소는 NULL)
  stepNo                Int?           @map("step_no") @db.UnsignedTinyInt
  /// [v1.2] 이 APPROVE가 전결에 의한 최종 확정임(출력 서식 "전결" 표기 근거)
  isDelegatedFinal      Boolean        @default(false) @map("is_delegated_final")
  /// REJECT 시 반려사유 — 애플리케이션에서 필수 검증
  comment               String?        @db.VarChar(500)
  /// APPROVE 시점 서명 이미지 사본의 스토리지 경로(key). employee.signaturePath 원본이 아닌 승인 시점 복제본(D-12)
  signatureSnapshotPath String?        @map("signature_snapshot_path") @db.VarChar(255)
  actedAt               DateTime       @default(now()) @map("acted_at")

  request ApprovalRequest @relation(fields: [requestId], references: [id])
  actor   Employee        @relation(fields: [actorId], references: [id])

  @@index([requestId, actedAt], name: "idx_hist_req")
  @@map("approval_history")
}

/// 연차 잔여. 음수 허용(엣지케이스 3) — 승인 시 경고는 앱 레벨.
/// [v1.2] balanceYear = year_basis: 입사일 기준 연차연도의 시작 연도(§3.5, 회계연도 기준 전환은 파일럿 후 보완).
/// remaining은 DB GENERATED ALWAYS AS (granted - used - reserved) STORED 컬럼 — 앱에서 쓰기 금지, 읽기 전용으로만 사용
model LeaveBalance {
  employeeId  BigInt   @map("employee_id") @db.UnsignedBigInt
  balanceYear Int      @map("balance_year") @db.Year
  /// 부여(D-9 규칙). Phase 1은 관리자 수동 입력, 자동 산정은 Phase 5
  granted     Decimal  @default(0) @db.Decimal(4, 1)
  /// 사용 확정(최종 APPROVED 시 가산)
  used        Decimal  @default(0) @db.Decimal(4, 1)
  /// 대기중 예약(제출 시 가산, 종결 시 해제) — D-2 이중신청 방지
  reserved    Decimal  @default(0) @db.Decimal(4, 1)
  /// DB 생성 컬럼(GENERATED ALWAYS AS ... STORED) — 읽기 전용. dbgenerated로 표시해
  /// create() 시 값을 생략할 수 있게 한다. 앱에서 이 필드에 값을 명시적으로 쓰지 말 것
  /// (쓰면 MySQL이 생성 컬럼 직접 삽입을 거부한다).
  remaining   Decimal  @default(dbgenerated("(granted - used - reserved)")) @db.Decimal(5, 1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, balanceYear])
  @@map("leave_balance")
}

/// 유대 잔여 — 1일 단위 "사용 트랙"(D-15). leave_balance와 동일 구조. 당해 연도 말 소멸, 이월 없음(D-11)
model SubstituteHolidayBalance {
  employeeId  BigInt   @map("employee_id") @db.UnsignedBigInt
  /// 발생 연도. 만료 판정(연도 경과분 사용 차단)은 앱/배치 레벨
  balanceYear Int      @map("balance_year") @db.Year
  /// [v1.2] 부여 합계(1일 단위). substitute_holiday_ledger 행 생성과 1:1 연동(+1) —
  /// D-15, 대장이 부여의 원천 기록(D-10 개정). 정합성은 앱 레벨
  granted     Decimal  @default(0) @db.Decimal(4, 1)
  used        Decimal  @default(0) @db.Decimal(4, 1)
  reserved    Decimal  @default(0) @db.Decimal(4, 1)
  /// DB 생성 컬럼(GENERATED ALWAYS AS ... STORED) — 읽기 전용. dbgenerated로 표시해
  /// create() 시 값을 생략할 수 있게 한다. 앱에서 이 필드에 값을 명시적으로 쓰지 말 것
  /// (쓰면 MySQL이 생성 컬럼 직접 삽입을 거부한다).
  remaining   Decimal  @default(dbgenerated("(granted - used - reserved)")) @db.Decimal(5, 1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, balanceYear])
  @@map("substitute_holiday_balance")
}

enum ShiftPeriod {
  DAY
  NIGHT
}

enum SignStatus {
  NOT_REQUESTED
  SIGN_REQUESTED
  SIGNED
}

enum SubstituteHolidaySource {
  MANUAL
  ATTENDANCE
}

/// [v1.2 신설] 유대 관리대장 — 시간 단위 "공단 인정 트랙"(A-4, D-15). v1.1의 SubstituteHolidayGrant를 대체.
/// 행 생성 = balance.granted +1 (1:1, 앱 레벨). 근무자 확인 서명 워크플로우 포함(C-4, D-16).
/// 유효 행 수 = balance.granted (앱 레벨 정합성)
model SubstituteHolidayLedger {
  id                            BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  employeeId                    BigInt                  @map("employee_id") @db.UnsignedBigInt
  /// 근무일(법정공휴일)
  workedHolidayDate             DateTime                @map("worked_holiday_date") @db.Date
  workedShift                   ShiftPeriod             @map("worked_shift")
  /// 사용예정일자(Phase 1 수동 / Phase 2 근무표 연동)
  plannedUseDate                DateTime?               @map("planned_use_date") @db.Date
  plannedUseShift               ShiftPeriod?            @map("planned_use_shift")
  /// 월기준근무시간(h). Phase 1 관리자 수동 기입 / Phase 2 §4.1 산식 자동. 서명 완료분은 재계산하지 않음(비소급 원칙 §4.4)
  baseMonthlyHours              Decimal?                @map("base_monthly_hours") @db.Decimal(6, 2)
  /// 실근무시간(h). Phase 1 수동 / Phase 3 GPS 자동
  actualWorkedHours             Decimal?                @map("actual_worked_hours") @db.Decimal(6, 2)
  /// 이월가능시간(분). §4.4: clamp(실근무 − 월기준, 0, 480). CHECK (carryable_minutes BETWEEN 0 AND 480) — DB 레벨
  carryableMinutes              Int                     @default(0) @map("carryable_minutes") @db.UnsignedSmallInt
  /// 근무자 확인 서명 상태(US-08~09). 7일 미서명 재알림은 배치(엣지 10)
  signStatus                    SignStatus              @default(NOT_REQUESTED) @map("sign_status")
  signRequestedAt               DateTime?               @map("sign_requested_at")
  signedAt                      DateTime?               @map("signed_at")
  /// 서명 시점 사본(key) — SIGNED 시 필수(앱 레벨). 행 정정 시 무효화(NULL 처리 + 재서명 요청 자동 발송 — 엣지 9)
  employeeSignatureSnapshotPath String?                 @map("employee_signature_snapshot_path") @db.VarChar(255)
  /// 기입 관리자(= 유대 1일 부여자)
  createdBy                     BigInt                  @map("created_by") @db.UnsignedBigInt
  createdAt                     DateTime                @default(now()) @map("created_at")
  /// 최근 정정 관리자
  amendedBy                     BigInt?                 @map("amended_by") @db.UnsignedBigInt
  amendedAt                     DateTime?               @map("amended_at")
  /// 정정 사유 — 정정 시 필수(앱 레벨, US-08)
  amendReason                   String?                 @map("amend_reason") @db.VarChar(300)
  /// 부여 취소 관리자(공휴일 근무 기록 오류 — 엣지 9)
  revokedBy                     BigInt?                 @map("revoked_by") @db.UnsignedBigInt
  revokedAt                     DateTime?               @map("revoked_at")
  /// 취소 시 balance -1 회수. 이미 사용된 뒤면 회수 대신 경고 표시(앱 레벨)
  revokeReason                  String?                 @map("revoke_reason") @db.VarChar(300)
  /// ATTENDANCE = Phase 3 공휴일 근무 감지 후보의 관리자 확정분(D-10)
  source                        SubstituteHolidaySource @default(MANUAL)

  employee Employee  @relation("SubstituteHolidayLedgerEmployee", fields: [employeeId], references: [id])
  creator  Employee  @relation("SubstituteHolidayLedgerCreator", fields: [createdBy], references: [id])
  amender  Employee? @relation("SubstituteHolidayLedgerAmender", fields: [amendedBy], references: [id])
  revoker  Employee? @relation("SubstituteHolidayLedgerRevoker", fields: [revokedBy], references: [id])

  notifications Notification[]

  @@unique([employeeId, workedHolidayDate], map: "uq_ledger_emp_day")
  @@index([signStatus, signRequestedAt], name: "idx_ledger_sign")
  @@map("substitute_holiday_ledger")
}

enum NotificationKind {
  NEW_REQUEST
  STEP_APPROVED
  APPROVED
  REJECTED
  REMINDER
  SIGN_REQUEST
  LEAVE_EXPIRY_60D
  LEAVE_EXPIRY_30D
  SH_EXPIRY
}

enum NotificationChannel {
  IN_APP
  PUSH
  ALIMTALK
}

model Notification {
  id          BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  recipientId BigInt              @map("recipient_id") @db.UnsignedBigInt
  requestId   BigInt?             @map("request_id") @db.UnsignedBigInt
  /// [v1.2] SIGN_REQUEST 등 유대 대장 관련 알림의 참조
  ledgerId    BigInt?             @map("ledger_id") @db.UnsignedBigInt
  /// [v1.2] STEP_APPROVED=중간승인 통지(다음 결재자·취소 통지 겸용), SIGN_REQUEST=유대 확인 서명 요청(US-09),
  /// LEAVE_EXPIRY_60D/30D=연차 소멸 임박 관리자 알림(C-10), SH_EXPIRY=유대 당해 연도 소멸 예정(엣지 8)
  kind        NotificationKind
  channel     NotificationChannel @default(IN_APP)
  body        String              @db.VarChar(300)
  readAt      DateTime?           @map("read_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  recipient Employee                 @relation(fields: [recipientId], references: [id])
  request   ApprovalRequest?         @relation(fields: [requestId], references: [id])
  ledger    SubstituteHolidayLedger? @relation(fields: [ledgerId], references: [id])

  @@index([recipientId, readAt, createdAt], name: "idx_noti_recipient")
  @@map("notification")
}

// =============================================================
// [Phase 2~4] 근무표 · 고시 파라미터 · 출퇴근 · 마감 (선행 정의)
//  * Phase 1 개발에는 불필요하나, FK 관계 확정을 위해 함께 배포
// =============================================================

/// 고시 파라미터 (연도/개정 버전 관리 — 수치 하드코딩 금지 원칙)
model RegulationParamSet {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  /// §4.1 산식의 일 근무시간
  hoursPerDay        Int       @default(8) @map("hours_per_day") @db.UnsignedTinyInt
  /// 수동 override. NULL이면 §4.1 산식으로 월별 자동 계산
  monthlyBaseHours   Decimal?  @map("monthly_base_hours") @db.Decimal(6, 2)
  ratioCaregiver     Decimal   @default(2.1) @map("ratio_caregiver") @db.Decimal(3, 1)
  ratioNursePer      Int       @default(25) @map("ratio_nurse_per") @db.UnsignedSmallInt
  ratioCookPer       Int       @default(25) @map("ratio_cook_per") @db.UnsignedSmallInt
  addonNurseExtraPt  Decimal   @default(1.2) @map("addon_nurse_extra_pt") @db.Decimal(3, 1)
  addonNurseRatioMax Decimal   @default(19.0) @map("addon_nurse_ratio_max") @db.Decimal(4, 1)
  addonSwPt          Decimal   @default(1.4) @map("addon_sw_pt") @db.Decimal(3, 1)
  addonPtPt          Decimal   @default(1.4) @map("addon_pt_pt") @db.Decimal(3, 1)
  addonNightPt       Decimal   @default(0.9) @map("addon_night_pt") @db.Decimal(3, 1)
  nightRatioMax      Int       @default(20) @map("night_ratio_max") @db.UnsignedSmallInt
  dayNightMultiple   Int       @default(2) @map("day_night_multiple") @db.UnsignedTinyInt
  nightDivisor       Int       @default(7) @map("night_divisor") @db.UnsignedTinyInt
  dayDivisor         Int       @default(14) @map("day_divisor") @db.UnsignedTinyInt
  addonRnPt          Decimal   @default(0.6) @map("addon_rn_pt") @db.Decimal(3, 1)
  addonRnBonus50     Decimal   @default(0.2) @map("addon_rn_bonus_50") @db.Decimal(3, 1)
  /// §4.4 유대 공단 인정 상한(당월 기준시간 초과분만, 최대 8h)
  subHolidayMaxHours Decimal   @default(8.0) @map("sub_holiday_max_hours") @db.Decimal(3, 1)
  /// [v1.2] D-9 연차 가산 포함 총 상한 — [V-3 근로기준법 제60조 제4항 원문 대조 후 확정 표기]
  annualLeaveCapDays Int       @default(25) @map("annual_leave_cap_days") @db.UnsignedTinyInt
  /// 계산식별 반올림/절사 규칙(§4.2 가산=버림, 감액=둘째자리 버림 후 첫째자리 4이하 버림 등)
  roundingRules      Json?     @map("rounding_rules")

  @@index([effectiveFrom, effectiveTo], name: "idx_param_period")
  @@map("regulation_param_set")
}

/// 월별 입소자 현원 (인력산정 입력값)
model MonthlyCensus {
  facilityId    BigInt @map("facility_id") @db.UnsignedBigInt
  yearMonth     String @map("year_month") @db.Char(7)
  residentCount Int    @map("resident_count") @db.UnsignedSmallInt
  /// 급여제공일수
  serviceDays   Int    @map("service_days") @db.UnsignedTinyInt

  facility Facility @relation(fields: [facilityId], references: [id])

  @@id([facilityId, yearMonth])
  @@map("monthly_census")
}

/// [v1.2 신설] 일별 적정 인원 설정(§4.5 — 팀×주/야 최소·최대, A-6)
model DailyStaffingRule {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId BigInt      @map("facility_id") @db.UnsignedBigInt
  /// NULL = 시설 전체 기준
  teamId     BigInt?     @map("team_id") @db.UnsignedBigInt
  period     ShiftPeriod
  minCount   Int         @default(0) @map("min_count") @db.UnsignedTinyInt
  /// NULL = 상한 없음
  maxCount   Int?        @map("max_count") @db.UnsignedTinyInt

  facility Facility @relation(fields: [facilityId], references: [id])
  team     Team?    @relation(fields: [teamId], references: [id])

  @@unique([facilityId, teamId, period], map: "uq_dsr")
  @@map("daily_staffing_rule")
}

enum RosterStatus {
  DRAFT
  COMPLETED
  CLOSING_APPROVAL
  CLOSED
}

/// 월 근무표 헤더. [v1.2] 작성중→작성완료→마감결재→마감(§4.8). COMPLETED에서 셀 수정 시 DRAFT 복귀,
/// 반려 시 DRAFT 복귀 — 전이·로그는 앱 레벨. CLOSED 셀 직접 수정 금지 — 결재 경유로만
model Roster {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId       BigInt       @map("facility_id") @db.UnsignedBigInt
  yearMonth        String       @map("year_month") @db.Char(7)
  status           RosterStatus @default(DRAFT)
  /// [v1.2] 마감 상신자(사회복지사)
  submittedBy      BigInt?      @map("submitted_by") @db.UnsignedBigInt
  submittedAt      DateTime?    @map("submitted_at")
  /// 마감 승인자(사무국장/시설장)
  closedBy         BigInt?      @map("closed_by") @db.UnsignedBigInt
  closedAt         DateTime?    @map("closed_at")
  /// [v1.2] 위반 존재 상태의 강행 마감 여부(D-19)
  forceClosed      Boolean      @default(false) @map("force_closed")
  /// [v1.2] 강행 마감 사유 — forceClosed=true 시 필수(앱 레벨). 당시 위반 목록은 ValidationResult 스냅샷으로 보존
  forceCloseReason String?      @map("force_close_reason") @db.VarChar(500)
  createdAt        DateTime     @default(now()) @map("created_at")

  facility  Facility  @relation(fields: [facilityId], references: [id])
  submitter Employee? @relation("RosterSubmitter", fields: [submittedBy], references: [id])
  closer    Employee? @relation("RosterCloser", fields: [closedBy], references: [id])

  scheduleEntries   ScheduleEntry[]
  validationResults ValidationResult[]

  @@unique([facilityId, yearMonth], map: "uq_roster_month")
  @@map("roster")
}

enum ScheduleEntrySource {
  MANUAL
  PRESET
  APPROVAL
}

/// 근무표 셀 (직원 × 일자). 승인 연차가 있는 셀은 프리셋이 덮어쓰지 않음(앱 레벨)
model ScheduleEntry {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  rosterId        BigInt              @map("roster_id") @db.UnsignedBigInt
  employeeId      BigInt              @map("employee_id") @db.UnsignedBigInt
  workDate        DateTime            @map("work_date") @db.Date
  shiftTypeId     BigInt              @map("shift_type_id") @db.UnsignedBigInt
  /// APPROVAL = request.approved 이벤트로 자동 반영된 셀(연차·유대·조정)
  source          ScheduleEntrySource @default(MANUAL)
  /// [v1.2] 가반영 표시(§4.10): step_approved 구독 시 true(글자만), approved 구독 시 false로 확정(셀 색칠)
  isProvisional   Boolean             @default(false) @map("is_provisional")
  /// 반영 근거 결재 건
  sourceRequestId BigInt?             @map("source_request_id") @db.UnsignedBigInt

  roster        Roster           @relation(fields: [rosterId], references: [id])
  employee      Employee         @relation(fields: [employeeId], references: [id])
  shiftType     ShiftType        @relation(fields: [shiftTypeId], references: [id])
  sourceRequest ApprovalRequest? @relation("ScheduleEntrySourceRequest", fields: [sourceRequestId], references: [id])

  @@unique([employeeId, workDate], map: "uq_entry")
  @@index([rosterId, workDate], name: "idx_entry_roster_date")
  @@map("schedule_entry")
}

/// 근무 패턴 프리셋 헤더 (§4.6 — 주야비 3조 2교대 등)
model ShiftPatternPreset {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  facilityId BigInt @map("facility_id") @db.UnsignedBigInt
  name       String @db.VarChar(50)
  /// 패턴 주기(주야비=6)
  cycleDays  Int    @map("cycle_days") @db.UnsignedTinyInt
  /// 조 수(주야비=3: A/B/C)
  teamCount  Int    @map("team_count") @db.UnsignedTinyInt

  facility Facility           @relation(fields: [facilityId], references: [id])
  items    ShiftPatternItem[]

  @@map("shift_pattern_preset")
}

/// 프리셋 상세: 조×일차별 근무유형
model ShiftPatternItem {
  presetId    BigInt @map("preset_id") @db.UnsignedBigInt
  /// 1=A조, 2=B조, 3=C조 …
  teamNo      Int    @map("team_no") @db.UnsignedTinyInt
  /// 주기 내 일차(1..cycleDays)
  dayIndex    Int    @map("day_index") @db.UnsignedTinyInt
  shiftTypeId BigInt @map("shift_type_id") @db.UnsignedBigInt

  preset    ShiftPatternPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  shiftType ShiftType          @relation(fields: [shiftTypeId], references: [id])

  @@id([presetId, teamNo, dayIndex])
  @@map("shift_pattern_item")
}

enum AttendanceMethod {
  GPS
  MANUAL
  ADMIN
}

enum AttendanceStatus {
  NORMAL
  MISSING_OUT
  MANUAL_PENDING
}

/// 출퇴근. 위치는 태그 시점 좌표만 저장(상시 추적 금지). 성능 요건: GPS 태그 처리 3초 이내(§5.1)
model AttendanceRecord {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  employeeId      BigInt           @map("employee_id") @db.UnsignedBigInt
  /// 귀속일(야간은 시작일 기준)
  workDate        DateTime         @map("work_date") @db.Date
  clockInAt       DateTime?        @map("clock_in_at")
  clockOutAt      DateTime?        @map("clock_out_at")
  inLat           Decimal?         @map("in_lat") @db.Decimal(10, 7)
  inLng           Decimal?         @map("in_lng") @db.Decimal(10, 7)
  outLat          Decimal?         @map("out_lat") @db.Decimal(10, 7)
  outLng          Decimal?         @map("out_lng") @db.Decimal(10, 7)
  /// MANUAL=수동태그(결재 승인 경유), ADMIN=관리자 보정
  method          AttendanceMethod @default(GPS)
  /// MANUAL/ADMIN 근거 결재 건(Phase 3)
  manualRequestId BigInt?          @map("manual_request_id") @db.UnsignedBigInt
  /// 휴게 차감 후 실근무분(자정 넘김 처리 포함)
  actualMinutes   Int?             @map("actual_minutes") @db.UnsignedSmallInt
  /// 법정공휴일 근무 여부(public_holiday 대조, 배치 마킹) — 유대 부여 후보 제시의 근거(D-10, Phase 3)
  isHolidayWork   Boolean          @default(false) @map("is_holiday_work")
  status          AttendanceStatus @default(NORMAL)
  createdAt       DateTime         @default(now()) @map("created_at")

  employee      Employee         @relation(fields: [employeeId], references: [id])
  manualRequest ApprovalRequest? @relation("AttendanceRecordManualRequest", fields: [manualRequestId], references: [id])

  @@unique([employeeId, workDate], map: "uq_att")
  @@index([workDate, status], name: "idx_att_date")
  @@map("attendance_record")
}

enum ValidationSeverity {
  WARN
  BLOCK
}

enum ValidationSnapshotStage {
  EDIT
  COMPLETED
  CLOSE
}

/// 검증 결과 스냅샷 (작성완료·마감 시점 보존 — 사후 감사, D-19 강행 마감 근거)
model ValidationResult {
  id            BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  rosterId      BigInt                  @map("roster_id") @db.UnsignedBigInt
  checkedAt     DateTime                @default(now()) @map("checked_at")
  /// [v1.2] COMPLETED=작성완료 시 스냅샷(§4.8), CLOSE=마감(강행 포함) 시 위반 목록
  snapshotStage ValidationSnapshotStage @default(EDIT) @map("snapshot_stage")
  /// 예: MONTHLY_STAFFING_CAREGIVER, NIGHT_ADDON_COND2, BASE_HOURS_SHORTFALL
  ruleCode      String                  @map("rule_code") @db.VarChar(40)
  severity      ValidationSeverity
  /// 환산인원, 필요인원, 미충족 조건 등
  detail        Json?

  roster Roster @relation(fields: [rosterId], references: [id])

  @@index([rosterId, snapshotStage, checkedAt], name: "idx_val_roster")
  @@map("validation_result")
}
